    "            continue\n",
    "        \n",
    "        word_count = len(window_words)\n",
    "        syllable_count = sum(english_syllable_count(w) for w in window_words)\n",
    "        score = 206.835 - 1.015 * (word_count / sentences) - 84.6 * (syllable_count / word_count)\n",
