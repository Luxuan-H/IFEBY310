    "    chunks = []\n",
    "    for i in range(0, len(words), chunk_size):\n",
    "        chunks.append(\" \".join(words[i:i+chunk_size]))\n",
    "    return chunks\n",
    "  \n",
    "# =====================================================================\n",
    "# Spark NLP Annotation Pipeline\n",
    "# =====================================================================\n",
    "# Stop any previous Spark session to avoid port conflicts\n",
